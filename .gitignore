# --- Conda environment (never commit; recreate from xf-transcriptome-atlas.yml) ---
y/

# --- Python junk ---
__pycache__/
*.pyc
*.pyo

# --- OS junk ---
.DS_Store
Thumbs.db

# --- Editor / backup files ---
*.bak
*~

# --- Leftover / superseded directories (kept locally, not for GitHub) ---
results/wgcna_original/

# --- Figures, raw flask photographs, and all intermediate/final pipeline
#     outputs: entirely regenerable by running the scripts in 01-07 against
#     your own full-size data/ files (see README.md for the stage-by-stage
#     commands). Not distributed through GitHub. ---
figures/
photos/
results/

# --- Debris from git-init attempts blocked by OneDrive file locks on this
#     machine; harmless, safe to delete by hand once OneDrive fully
#     releases them (see rm failures logged during setup) ---
.git_broken/
.git_stale2/
.git_stale3/

# --- Belt-and-suspenders: .tiff/.tif are also caught by figures/ and photos/
#     above, but this catches stray copies elsewhere too. FIJI/masks/ is a
#     placeholder the user fills with their own images (see that folder's
#     README.md), so it's exempted. ---
*.tiff
*.tif
!07_biofilm_quantification/FIJI/masks/*.tif

# --- Large intermediate/example inputs not needed to run the pipeline from
#     scratch (regenerated by 01_preprocessing scripts) ---
01_preprocessing/data/

# --- Raw per-sample data (CLC Genomics Workbench "Gene Expression" .xlsx
#     exports): not included, per data/README.md's data-sharing policy.
#     build_matrices_from_fpkm_xlsx.py documents the expected directory
#     layout (FPKM/<strain>/<medium>/*.xlsx [+pXF51/]) for anyone supplying
#     their own copy of this raw data. ---
01_preprocessing/FPKM/

# --- Reference genomes, downloadable directly from NCBI (see data/README.md
#     for accession numbers) -- not distributed here. Left on disk as
#     leftover debris from an earlier commit (OneDrive lock prevented
#     deletion); safe to delete by hand. ---
data/9a5c.gbff
data/Temecula1.gbff

# --- Only tpm_expression.csv / sample_info.csv are shipped as the data/
#     format examples; these companion files are not distributed (see
#     data/README.md for how to regenerate each). Left on disk as leftover
#     debris (OneDrive lock); safe to delete by hand. ---
data/tpm_expression_original.csv
data/tpm_expression_wgcna.csv
data/sample_info_original.csv

# --- GO-enrichment result folders beyond the one representative example kept
#     in data/deseq2_go_results/ (see that folder + data/README.md): full
#     regeneration comes from run_go_enrichment.py, not from files bundled
#     here. Left on disk as leftover debris (OneDrive lock); safe to delete
#     by hand. ---
data/deseq2_go_results/9a5c_PIM6_1d_vs_9a5c_PWG_3d/
data/deseq2_go_results/9a5c_PIM6_1d_vs_Temecula1_PIM6_1d/
